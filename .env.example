# Banco de dados (compatível com o docker-compose.yml)
DATABASE_URL="postgresql://duda:duda15anos@localhost:5432/niver_duda?schema=public"

# Portas expostas na sua máquina (mude se alguma já estiver em uso)
APP_PORT=3000
DB_PORT=5432

# URL pública do site (usada nos links enviados aos convidados)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Painel admin
ADMIN_PASSWORD="troque-esta-senha"
SUPER_ADMIN_PASSWORD="troque-esta-senha-super"
AUTH_SECRET="gere-um-segredo-aleatorio-com: openssl rand -hex 32"

# Dados da festa
NEXT_PUBLIC_EVENT_NAME="15 Anos da Duda"
NEXT_PUBLIC_EVENT_DATE="2026-12-12T20:00:00-03:00"
NEXT_PUBLIC_EVENT_VENUE="Local a confirmar"
NEXT_PUBLIC_EVENT_CITY="São Paulo - SP"

# E-mail (Resend - https://resend.com)
RESEND_API_KEY=""
# Enquanto não tiver domínio verificado no Resend, use onboarding@resend.dev
EMAIL_FROM="Festa da Duda <onboarding@resend.dev>"

# WhatsApp (Twilio - https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Número do sandbox/remetente Twilio no formato +14155238886
TWILIO_WHATSAPP_FROM="+14155238886"
# DDI padrão adicionado quando o celular não tem código do país
DEFAULT_COUNTRY_CODE="55"

# WhatsApp - provedor: "evolution" (self-hosted, QR code) ou "twilio"
WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL="http://evolution:8080"
EVOLUTION_API_KEY="duda15evolution"
EVOLUTION_INSTANCE="festa-duda"
