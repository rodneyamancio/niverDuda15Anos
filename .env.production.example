# Produção — copie para .env no servidor e preencha
# (usado pelo docker-compose.prod.yml)

# Senha do Postgres em produção (obrigatória) — gere com: openssl rand -hex 16
POSTGRES_PASSWORD=""

# Porta local do app no servidor (o Nginx aponta para ela)
APP_PORT=3010

# URL pública do site — usada nos links enviados aos convidados
NEXT_PUBLIC_APP_URL="https://SEU-DOMINIO-AQUI"

# Painel admin (valem até serem trocadas pela tela /admin/senha)
ADMIN_PASSWORD="troque-esta-senha"
SUPER_ADMIN_PASSWORD="troque-esta-senha-super"
# Obrigatório — gere com: openssl rand -hex 32
AUTH_SECRET=""

# Dados da festa (também editáveis em /admin/config depois)
NEXT_PUBLIC_EVENT_NAME="15 Anos da Duda"
NEXT_PUBLIC_EVENT_DATE="2026-12-12T20:00:00-03:00"
NEXT_PUBLIC_EVENT_VENUE="Local a confirmar"
NEXT_PUBLIC_EVENT_CITY="São Paulo - SP"

# E-mail (Resend) — também editável em /admin/config
RESEND_API_KEY=""
EMAIL_FROM="Festa da Duda <onboarding@resend.dev>"

# WhatsApp (Twilio) — também editável em /admin/config
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"
DEFAULT_COUNTRY_CODE="55"
